# india-subscriptions serve: every variable the service reads. Copy to .env and
# fill in; leave a gateway's variables out entirely to switch that gateway off.
# A gateway with some, but not all, of its required variables set is an error.
# Variables left empty count as unset. Never commit the filled-in file.

# --- Service ---------------------------------------------------------------
# Bearer token clients must send (Authorization: Bearer ...). Required unless you start with --allow-unauthenticated.
INDIA_SUBSCRIPTIONS_API_KEY=
# Interface to listen on; the default is loopback only. Use 0.0.0.0 deliberately.
HOST=127.0.0.1
# Port to listen on (0 picks a free one).
PORT=8787

# --- Razorpay (needs KEY_ID and KEY_SECRET) ----------------------------------
# API key id (the checkout "key").
RAZORPAY_KEY_ID=
# API key secret.
RAZORPAY_KEY_SECRET=
# Webhook secret from the Razorpay dashboard; without it Razorpay webhooks are rejected.
RAZORPAY_WEBHOOK_SECRET=
# Optional: length in years of a "bill until cancelled" subscription (1-100, default 10).
RAZORPAY_DEFAULT_DURATION_YEARS=
# Optional: replaces https://api.razorpay.com (a proxy or mock server).
RAZORPAY_BASE_URL=

# --- Cashfree (needs CLIENT_ID, CLIENT_SECRET and ENVIRONMENT) ---------------
# Cashfree app id (x-client-id).
CASHFREE_CLIENT_ID=
# Cashfree secret key (x-client-secret).
CASHFREE_CLIENT_SECRET=
# test (sandbox) or live (real money).
CASHFREE_ENVIRONMENT=
# Optional: secret that signs webhooks; defaults to the client secret.
CASHFREE_WEBHOOK_SECRET=
# Optional: x-api-version as YYYY-MM-DD; defaults to the version the adapter was built for.
CASHFREE_API_VERSION=
# Optional: replaces the Cashfree host, including the /pg prefix (a proxy or mock server).
CASHFREE_BASE_URL=

# --- PayU (needs KEY, SALT and ENVIRONMENT) ----------------------------------
# PayU merchant key.
PAYU_KEY=
# PayU merchant salt.
PAYU_SALT=
# test (test.payu.in) or live (secure.payu.in).
PAYU_ENVIRONMENT=
# Optional: default success return URL (surl) for subscriptions without a returnUrl.
PAYU_SUCCESS_URL=
# Optional: default failure return URL (furl); falls back to the success URL.
PAYU_FAILURE_URL=
# Optional: consent hash layout, one of six_pipes (default), five_pipes, four_pipes; change only if PayU rejects the hash.
PAYU_CONSENT_HASH_LAYOUT=
# Optional: true to normalise PayU's unsigned cancellation/refund webhooks; only behind an IP allow-list for PayU.
PAYU_ACCEPT_UNSIGNED_WEBHOOKS=
# Optional: replaces the PayU _payment URL (a proxy or mock server).
PAYU_PAYMENT_URL=
# Optional: replaces the PayU postservice URL, including ?form=2 (a proxy or mock server).
PAYU_API_URL=

# --- Billing scheduler -------------------------------------------------------
# Path of the scheduler's state file (one JSON file, one service instance only).
# Unset: the scheduler is off and gateways that need it (merchant-scheduled mandates) refuse to create subscriptions.
SCHEDULER_STORE_FILE=
# Seconds between scheduler ticks (1-86400, default 300).
SCHEDULER_TICK_SECONDS=300

# --- Events webhook (optional; set both or neither) --------------------------
# Every batch of verified gateway events is POSTed here as JSON; a non-2xx answer makes the gateway retry.
EVENTS_WEBHOOK_URL=
# Shared secret: each POST carries x-india-subscriptions-signature (hex HMAC-SHA256 of the exact body) and x-india-subscriptions-timestamp.
EVENTS_WEBHOOK_SECRET=
