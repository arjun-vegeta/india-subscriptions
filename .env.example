# india-subscriptions serve: every variable the service reads. Copy to .env and
# fill in; leave a gateway's variables out entirely to switch that gateway off.
# A gateway with some, but not all, of its required variables set is an error.
# Variables left empty count as unset. Never commit the filled-in file.

# --- Service ---------------------------------------------------------------
# Bearer token clients must send (Authorization: Bearer ...). Required unless you start with --allow-unauthenticated.
INDIA_SUBSCRIPTIONS_API_KEY=
# Interface to listen on; the default is loopback only. Use 0.0.0.0 deliberately.
HOST=127.0.0.1
# Port to listen on (0 picks a free one).
PORT=8787

# --- Razorpay (needs KEY_ID and KEY_SECRET) ----------------------------------
# API key id (the checkout "key").
RAZORPAY_KEY_ID=
# API key secret.
RAZORPAY_KEY_SECRET=
# Webhook secret from the Razorpay dashboard; without it Razorpay webhooks are rejected.
RAZORPAY_WEBHOOK_SECRET=
# Optional: length in years of a "bill until cancelled" subscription (1-100, default 10).
RAZORPAY_DEFAULT_DURATION_YEARS=
# Optional: replaces https://api.razorpay.com (a proxy or mock server).
RAZORPAY_BASE_URL=

# --- Cashfree (needs CLIENT_ID, CLIENT_SECRET and ENVIRONMENT) ---------------
# Cashfree app id (x-client-id).
CASHFREE_CLIENT_ID=
# Cashfree secret key (x-client-secret).
CASHFREE_CLIENT_SECRET=
# test (sandbox) or live (real money).
CASHFREE_ENVIRONMENT=
# Optional: secret that signs webhooks; defaults to the client secret.
CASHFREE_WEBHOOK_SECRET=
# Optional: x-api-version as YYYY-MM-DD; defaults to the version the adapter was built for.
CASHFREE_API_VERSION=
# Optional: replaces the Cashfree host, including the /pg prefix (a proxy or mock server).
CASHFREE_BASE_URL=

# --- PayU (needs KEY, SALT and ENVIRONMENT) ----------------------------------
# PayU merchant key.
PAYU_KEY=
# PayU merchant salt.
PAYU_SALT=
# test (test.payu.in) or live (secure.payu.in).
PAYU_ENVIRONMENT=
# Optional: default success return URL (surl) for subscriptions without a returnUrl.
PAYU_SUCCESS_URL=
# Optional: default failure return URL (furl); falls back to the success URL.
PAYU_FAILURE_URL=
# Optional: consent hash layout, one of six_pipes (default), five_pipes, four_pipes; change only if PayU rejects the hash.
PAYU_CONSENT_HASH_LAYOUT=
# Optional: true to normalise PayU's unsigned cancellation/refund webhooks; only behind an IP allow-list for PayU.
PAYU_ACCEPT_UNSIGNED_WEBHOOKS=
# Optional: replaces the PayU _payment URL (a proxy or mock server).
PAYU_PAYMENT_URL=
# Optional: replaces the PayU postservice URL, including ?form=2 (a proxy or mock server).
PAYU_API_URL=

# --- PhonePe (needs CLIENT_ID, CLIENT_SECRET, CLIENT_VERSION and ENVIRONMENT) --
# PhonePe Business Dashboard client id (Developer Settings).
PHONEPE_CLIENT_ID=
# PhonePe client secret.
PHONEPE_CLIENT_SECRET=
# The client version issued with the credentials (a number such as 1, or text).
PHONEPE_CLIENT_VERSION=
# test (PhonePe sandbox/UAT) or live (production).
PHONEPE_ENVIRONMENT=
# Webhook username from the dashboard ("SHA (Username & Password)"); set with the password, or PhonePe webhooks are rejected.
PHONEPE_WEBHOOK_USERNAME=
# Webhook password; set together with the username.
PHONEPE_WEBHOOK_PASSWORD=
# Optional: default redirect URL for subscriptions without a returnUrl.
PHONEPE_REDIRECT_URL=
# Optional: replaces the PhonePe PG host (a proxy or mock server).
PHONEPE_API_URL=
# Optional: replaces the PhonePe OAuth token URL (a proxy or mock server).
PHONEPE_TOKEN_URL=

# --- Paytm (needs MID, MERCHANT_KEY, WEBSITE and ENVIRONMENT) ----------------
# Paytm merchant id (different for staging and production).
PAYTM_MID=
# Paytm merchant key: exactly 16 bytes, the AES key of Paytm's checksum (also verifies webhooks).
PAYTM_MERCHANT_KEY=
# websiteName: WEBSTAGING on staging, DEFAULT on production, or the name Paytm gave you.
PAYTM_WEBSITE=
# test (staging hosts) or live (production hosts).
PAYTM_ENVIRONMENT=
# Optional: default callback URL for subscriptions without a returnUrl.
PAYTM_CALLBACK_URL=
# Optional: head.channelId of the Theia-style APIs, WEB or WAP (omitted by default).
PAYTM_CHANNEL_ID=
# Optional: head.clientId, only for merchants with more than one key.
PAYTM_CLIENT_ID=
# Optional: subscriptionGraceDays for merchant-collected subscriptions (0-365; default derived from the schedule).
PAYTM_GRACE_DAYS=
# Optional: subscriptionRetryCount for merchant-collected subscriptions (1-10, default 3).
PAYTM_RETRY_COUNT=
# Optional: years a subscription without an end date stays valid (1-30, default 5).
PAYTM_MANDATE_YEARS=
# Optional: reason shown in the pre-debit notification (at most 50 characters, default "Subscription renewal").
PAYTM_DEBIT_REASON=
# Optional: replaces the Paytm subscription-service host (a proxy or mock server).
PAYTM_SUBSCRIPTION_BASE_URL=
# Optional: replaces the Paytm Transaction Status API host.
PAYTM_TRANSACTION_STATUS_BASE_URL=
# Optional: replaces the Paytm Refund API host.
PAYTM_REFUND_BASE_URL=
# Optional: replaces the host customers are sent to for authorisation.
PAYTM_CHECKOUT_BASE_URL=

# --- Billing scheduler -------------------------------------------------------
# Path of the scheduler's state file (one JSON file, one service instance only).
# Unset: the scheduler is off and gateways that need it (merchant-scheduled mandates) refuse to create subscriptions.
SCHEDULER_STORE_FILE=
# Seconds between scheduler ticks (1-86400, default 300).
SCHEDULER_TICK_SECONDS=300

# --- Events webhook (optional; set both or neither) --------------------------
# Where to POST events as JSON. Gateway webhook events ({"kind":"gateway","provider":...,"events":[...]}) are sent
# before the gateway is answered: a non-2xx answer makes the gateway retry. Billing scheduler events
# ({"kind":"scheduler","events":[...]}, only with SCHEDULER_STORE_FILE) are sent in the background, retried with
# backoff 5 times, then logged and dropped. Every event has an "id": de-duplicate on it (delivery is at least once).
EVENTS_WEBHOOK_URL=
# Shared secret. Each POST carries two headers:
#   x-india-subscriptions-timestamp: Unix time in whole seconds, e.g. 1767225600
#   x-india-subscriptions-signature: lower-case hex HMAC-SHA256 (key = this secret) of the string
#       <timestamp> "." <raw request body>      e.g. 1767225600.{"kind":"scheduler","events":[...]}
# A receiver recomputes it over the exact bytes received, compares in constant time, and rejects a timestamp
# that is missing, not a number, or more than 300 seconds from its clock (past or future).
# TypeScript receivers can call verifyEventsSignature() from india-subscriptions.
EVENTS_WEBHOOK_SECRET=
