{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "india-subscriptions unified model",
  "$defs": {
    "Provider": {
      "type": "string",
      "enum": [
        "razorpay",
        "cashfree",
        "payu"
      ]
    },
    "Currency": {
      "type": "string",
      "enum": [
        "INR"
      ]
    },
    "SubscriptionStatus": {
      "type": "string",
      "enum": [
        "created",
        "pending_authorization",
        "trialing",
        "active",
        "past_due",
        "halted",
        "paused",
        "cancelled",
        "completed",
        "expired",
        "failed"
      ]
    },
    "ChargeStatus": {
      "type": "string",
      "enum": [
        "scheduled",
        "pending",
        "succeeded",
        "failed",
        "cancelled",
        "refunded",
        "partially_refunded"
      ]
    },
    "ChargeKind": {
      "type": "string",
      "enum": [
        "authorization",
        "recurring",
        "upfront"
      ]
    },
    "RefundStatus": {
      "type": "string",
      "enum": [
        "pending",
        "succeeded",
        "failed"
      ]
    },
    "PaymentMethod": {
      "type": "string",
      "enum": [
        "upi",
        "card",
        "enach",
        "physical_nach"
      ]
    },
    "SchedulingMode": {
      "type": "string",
      "enum": [
        "gateway",
        "merchant"
      ]
    },
    "EventType": {
      "type": "string",
      "enum": [
        "subscription.authorized",
        "subscription.authorization_failed",
        "subscription.activated",
        "subscription.charged",
        "subscription.charge_failed",
        "subscription.charge_scheduled",
        "subscription.past_due",
        "subscription.halted",
        "subscription.paused",
        "subscription.resumed",
        "subscription.updated",
        "subscription.cancelled",
        "subscription.completed",
        "subscription.expired",
        "refund.succeeded",
        "refund.failed",
        "unknown"
      ]
    },
    "Environment": {
      "type": "string",
      "enum": [
        "test",
        "live"
      ]
    },
    "BillingInterval": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "enum": [
            "day",
            "week",
            "month",
            "year"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "unit",
        "count"
      ],
      "additionalProperties": false
    },
    "Customer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+?[0-9]{10,15}$"
        }
      },
      "additionalProperties": false
    },
    "CreatePlanInput": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "amount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "default": "INR",
          "$ref": "#/$defs/Currency"
        },
        "interval": {
          "$ref": "#/$defs/BillingInterval"
        },
        "scheduling": {
          "$ref": "#/$defs/SchedulingMode"
        },
        "maxAmount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxCycles": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "metadata": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "amount",
        "currency",
        "interval"
      ],
      "additionalProperties": false
    },
    "Plan": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "interval": {
          "$ref": "#/$defs/BillingInterval"
        },
        "scheduling": {
          "$ref": "#/$defs/SchedulingMode"
        },
        "maxAmount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxCycles": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "providerStatus": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "metadata": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "raw": {}
      },
      "required": [
        "provider",
        "id",
        "name",
        "amount",
        "currency",
        "scheduling",
        "raw"
      ],
      "additionalProperties": false
    },
    "CheckoutInstruction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "redirect"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "form_post"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "fields": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "url",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "razorpay_checkout"
            },
            "keyId": {
              "type": "string"
            },
            "subscriptionId": {
              "type": "string"
            },
            "hostedUrl": {
              "type": "string",
              "format": "uri"
            },
            "callbackUrl": {
              "type": "string",
              "format": "uri"
            },
            "prefill": {
              "$ref": "#/$defs/Customer"
            }
          },
          "required": [
            "kind",
            "keyId",
            "subscriptionId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cashfree_checkout"
            },
            "sessionId": {
              "type": "string"
            },
            "environment": {
              "$ref": "#/$defs/Environment"
            }
          },
          "required": [
            "kind",
            "sessionId",
            "environment"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Trial": {
      "type": "object",
      "properties": {
        "days": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "endsAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "additionalProperties": false
    },
    "CreateSubscriptionInput": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "plan": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/CreatePlanInput"
            }
          ]
        },
        "customer": {
          "$ref": "#/$defs/Customer"
        },
        "quantity": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "totalCycles": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "trial": {
          "$ref": "#/$defs/Trial"
        },
        "startAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "upfrontAmount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "upfrontLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "paymentMethods": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/PaymentMethod"
          }
        },
        "authorizeBy": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "mandateEndsAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "returnUrl": {
          "type": "string",
          "format": "uri"
        },
        "notifyCustomer": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "plan",
        "customer"
      ],
      "additionalProperties": false
    },
    "Subscription": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "id": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "planId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SubscriptionStatus"
        },
        "providerStatus": {
          "type": "string"
        },
        "scheduling": {
          "$ref": "#/$defs/SchedulingMode"
        },
        "customer": {
          "$ref": "#/$defs/Customer"
        },
        "quantity": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxAmount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "interval": {
          "$ref": "#/$defs/BillingInterval"
        },
        "totalCycles": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "paidCycles": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "remainingCycles": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "startAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "trialEndsAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "currentPeriodStart": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "currentPeriodEnd": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "nextChargeAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "mandateEndsAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "cancelAtPeriodEnd": {
          "type": "boolean"
        },
        "paymentMethod": {
          "$ref": "#/$defs/PaymentMethod"
        },
        "checkout": {
          "$ref": "#/$defs/CheckoutInstruction"
        },
        "metadata": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "raw": {}
      },
      "required": [
        "provider",
        "id",
        "status",
        "providerStatus",
        "scheduling",
        "raw"
      ],
      "additionalProperties": false
    },
    "CancelSubscriptionOptions": {
      "type": "object",
      "properties": {
        "mode": {
          "default": "immediately",
          "type": "string",
          "enum": [
            "immediately",
            "at_period_end"
          ]
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "PauseSubscriptionOptions": {
      "type": "object",
      "properties": {
        "resumeAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "additionalProperties": false
    },
    "ResumeSubscriptionOptions": {
      "type": "object",
      "properties": {
        "nextChargeAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "additionalProperties": false
    },
    "UpdateSubscriptionInput": {
      "type": "object",
      "properties": {
        "planId": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
