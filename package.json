{
  "name": "india-subscriptions",
  "version": "0.1.0",
  "description": "One headless API for subscriptions and payments on Indian payment gateways (Razorpay, Cashfree, PayU, PhonePe, Paytm) and app stores (Apple App Store, Google Play): one-time payments, mandates, recurring charges, a gateway router, purchase sessions with entitlements, and webhooks. Bring your own keys.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/esm/schema-registry.js",
    "./dist/cjs/schema-registry.js"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/esm/server-entry.d.ts",
        "default": "./dist/esm/server-entry.js"
      },
      "require": {
        "types": "./dist/cjs/server-entry.d.ts",
        "default": "./dist/cjs/server-entry.js"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/esm/postgres-entry.d.ts",
        "default": "./dist/esm/postgres-entry.js"
      },
      "require": {
        "types": "./dist/cjs/postgres-entry.d.ts",
        "default": "./dist/cjs/postgres-entry.js"
      }
    },
    "./checkout": {
      "import": {
        "types": "./dist/esm/checkout/index.d.ts",
        "default": "./dist/esm/checkout/index.js"
      },
      "require": {
        "types": "./dist/cjs/checkout/index.d.ts",
        "default": "./dist/cjs/checkout/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "server": [
        "dist/cjs/server-entry.d.ts"
      ],
      "postgres": [
        "dist/cjs/postgres-entry.d.ts"
      ],
      "checkout": [
        "dist/cjs/checkout/index.d.ts"
      ]
    }
  },
  "bin": {
    "india-subscriptions": "./dist/esm/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "openapi": "tsx scripts/export-openapi.ts",
    "check:package": "node scripts/check-package.mjs",
    "docs:reference": "tsx scripts/generate-docs-reference.ts"
  },
  "keywords": [
    "subscriptions",
    "recurring-payments",
    "upi-autopay",
    "enach",
    "mandate",
    "razorpay",
    "cashfree",
    "payu",
    "phonepe",
    "paytm",
    "app-store",
    "google-play",
    "in-app-purchase",
    "user-choice-billing",
    "payment-routing",
    "entitlements",
    "india",
    "payments"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  }
}
