{
  "name": "india-subscriptions",
  "version": "0.1.0",
  "description": "One headless API for subscriptions on Indian payment gateways (Razorpay, Cashfree, PayU): plans, trials, mandates, recurring charges and webhooks. Bring your own gateway keys.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./checkout": {
      "import": {
        "types": "./dist/esm/checkout/index.d.ts",
        "default": "./dist/esm/checkout/index.js"
      },
      "require": {
        "types": "./dist/cjs/checkout/index.d.ts",
        "default": "./dist/cjs/checkout/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "subscriptions",
    "recurring-payments",
    "upi-autopay",
    "enach",
    "mandate",
    "razorpay",
    "cashfree",
    "payu",
    "india",
    "payments"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
